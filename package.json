{
  "name": "opmylife",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Turn a photo album + a song into a beat-synced ~90s animated opening. Orchestration layer over third-party AI model APIs, a durable BullMQ job pipeline, and credit billing.",
  "homepage": "https://opmylife.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/the-mantis-shrimp/opmylife.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx worker/index.ts",
    "migrate": "tsx db/migrate.ts",
    "r2:check": "tsx scripts/r2-check.ts",
    "vision:check": "tsx scripts/vision-check.ts",
    "gateway:check": "tsx scripts/gateway-check.ts",
    "queue:clear": "tsx scripts/queue-clear.ts",
    "queue:peek": "tsx scripts/queue-peek.ts",
    "typecheck": "tsc --noEmit",
    "lint": "next lint"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@aws-sdk/client-s3": "^3.637.0",
    "@aws-sdk/s3-request-presigner": "^3.637.0",
    "@clerk/nextjs": "^5.7.0",
    "@fal-ai/client": "^1.10.1",
    "bullmq": "^5.12.0",
    "dotenv": "^16.4.5",
    "heic2any": "^0.0.4",
    "ioredis": "^5.4.1",
    "next": "14.2.35",
    "pg": "^8.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stripe": "^16.8.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
