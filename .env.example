# ──────────────────────────────────────────────────────────────────────────
# ai-anime-op environment
# Copy to .env.local for local dev. In Railway, set these per-service.
# Datastore URLs in Railway come from REFERENCE VARIABLES — never hardcode a
# public DB domain (see docs/railway-deployment-topology.md).
# ──────────────────────────────────────────────────────────────────────────

# --- Datastores (Railway: use ${{Postgres.DATABASE_URL}} / ${{Redis.REDIS_URL}}) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/anime_op
REDIS_URL=redis://localhost:6379

# --- App ---
APP_URL=http://localhost:3000
NODE_ENV=development

# How many credits to grant a new user (Phase 1: stub balance, no real money).
STARTING_CREDIT_GRANT=100
# Cost (in credits) of one final encode. Charged ONLY on final encode.
FINAL_ENCODE_COST=10
# Hours after a render completes before TTL cleanup deletes inputs/outputs.
RENDER_TTL_HOURS=72
# Max generation attempts per shot before it is failed (cost control).
SHOT_MAX_ATTEMPTS=2
# Abuse/cost controls: free previews cost real model spend, so cap the LIFETIME
# total per user, and cap how many renders one user can have running at once.
PREVIEW_LIMIT=3
MAX_CONCURRENT_RENDERS=2
# Max photos per project (album). The style-reference cap (3) is separate.
MAX_PHOTOS_PER_PROJECT=30

# --- Cloudflare R2 (object storage; presigned uploads + lifecycle TTL) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=anime-op-dev
# Optional public base URL for downloads if you front R2 with a custom domain.
R2_PUBLIC_BASE_URL=
# Public base URL for PERSISTENT gallery/marketing videos — a SEPARATE public R2
# bucket with NO lifecycle TTL (see docs/gallery-assets.md). e.g. https://cdn.opmylife.com
# Leave blank to show gradient placeholders in the gallery.
GALLERY_ASSET_BASE_URL=
# The gallery bucket NAME. When set, the gallery LISTS it (drop a file in → it
# appears) and derives titles from filenames. Requires the R2 token to have read
# access to this bucket. Blank → the code fallback list.
GALLERY_BUCKET=

# --- Clerk (auth) ---
# Leave blank to run with the local dev user (no sign-in). Set both keys to
# enable real auth; the app then shows sign-in and protects pages. See docs/setup.md.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Point Clerk at the in-app sign-in/up pages and where to land afterward.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# --- Model APIs (worker needs these; web needs them only to surface config) ---
# Image + image-to-video gateway: fal.ai API key.
MODEL_GATEWAY_KEY=
# fal model routes (any fal-hosted endpoint works — e.g. set I2V_MODEL_FINAL to
# a Veo endpoint like fal-ai/veo3.1/image-to-video for Google's video model).
# IMAGE_MODEL turns a photo into the stylized (anime/pixar) character reference.
# Default is nano-banana-pro (does a full redraw). nano-banana/edit is faster but
# too conservative (keeps output photographic). Alternatives:
#   fal-ai/gemini-25-flash-image/edit
IMAGE_MODEL=fal-ai/nano-banana-pro/edit
I2V_MODEL_PREVIEW=fal-ai/kling-video/v2.1/standard/image-to-video
I2V_MODEL_FINAL=fal-ai/kling-video/v3/pro/image-to-video
# Vision LLM for album analysis + director/storyboard (Anthropic API key).
VISION_LLM_KEY=
# Claude model used for vision work. Default: claude-opus-4-8.
VISION_LLM_MODEL=claude-opus-4-8
# Music generation: Suno / Udio.
MUSIC_API_KEY=

# Global default: "stub" runs the pipeline end-to-end with deterministic fake
# models (no external spend); "live" calls the real APIs.
MODELS_MODE=stub
# Per-model overrides so integrations can go live ONE AT A TIME (each falls
# back to MODELS_MODE when unset). E.g. set VISION_MODE=live with the others
# stubbed to test the vision integration alone.
VISION_MODE=
GATEWAY_MODE=
MUSIC_MODE=

# --- Stripe (billing; Phase 2 — webhook route exists but no real charges yet) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
